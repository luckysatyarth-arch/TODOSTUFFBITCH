# ---------------------------------------------------------------------------
# REQUIRED — the core application will not start without these.
# ---------------------------------------------------------------------------

# Supabase project URL and browser-safe key. Both are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Server-only. Bypasses RLS, so it must never be exposed to the browser or
# committed. Used by the cron job, webhook handlers and background workers.
# Find it at: Supabase dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used for OAuth redirects and the links inside reports.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# REQUIRED for the 9pm scheduled reports.
# ---------------------------------------------------------------------------

# Shared secret the cron endpoint checks before doing any work, so the route
# cannot be triggered by anyone who finds the URL. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# Reporting timezone. Changing this changes which calendar day a report covers.
REPORT_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# AI — optional. Without a key, extraction, search answers and report
# narratives are disabled and the UI says so. Task, project, calendar and
# report *numbers* never depend on a model and keep working regardless.
# ---------------------------------------------------------------------------

# 'anthropic' or 'openai'.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Embeddings for semantic search. 1536 dimensions is baked into the database
# schema (document_embeddings.embedding), so a model with a different output
# size needs a migration.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Speech-to-text. 'openai' (Whisper), or 'none' to accept audio uploads but
# require the transcript to be typed or pasted in.
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=whisper-1

# ---------------------------------------------------------------------------
# Credential encryption — REQUIRED if any integration is connected.
# ---------------------------------------------------------------------------

# AES-256-GCM key for OAuth tokens at rest, 32 bytes hex (64 chars).
#   openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# WhatsApp — optional. See docs/RESEARCH-WHATSAPP.md for what is and is not
# possible. 'dry_run' records a fully-formed delivery without contacting a
# provider, which is how the reporting pipeline is tested without credentials.
# ---------------------------------------------------------------------------

# 'meta_cloud' | 'twilio' | 'dry_run'
WHATSAPP_PROVIDER=dry_run

# Meta WhatsApp Cloud API. Group sending additionally requires an Official
# Business Account and is capped at 8 participants including the sender.
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_BUSINESS_ACCOUNT_ID=
WHATSAPP_META_API_VERSION=v23.0
# Approved template used for the 9pm send. A business-initiated message
# outside a 24-hour service window must be a template, not free text.
WHATSAPP_META_TEMPLATE_NAME=daily_report
WHATSAPP_META_TEMPLATE_LANGUAGE=en

# Twilio WhatsApp. Direct sends only; Twilio exposes no group sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Verifies inbound webhooks. WHATSAPP_WEBHOOK_VERIFY_TOKEN answers Meta's
# subscription handshake; WHATSAPP_APP_SECRET checks the X-Hub-Signature-256
# signature on every delivery so forged captures are rejected.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------------------------------------------------------------------------
# Search connectors — all optional. A connector with no credentials reports
# status 'requires_setup' in the UI and is excluded from search.
# ---------------------------------------------------------------------------

# Google Drive and Gmail (same OAuth client; scopes are requested per feature).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Graph, for Outlook mail and Teams.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Notion public integration.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
